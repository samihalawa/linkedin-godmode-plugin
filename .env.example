# Secrets: environment only
ANCHOR_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional non-secret runtime settings
LINKEDIN_GODMODE_CONFIG=~/.config/linkedin-godmode/config.json
LINKEDIN_GODMODE_STATE_DIR=~/.local/state/linkedin-godmode
LINKEDIN_GODMODE_PROFILE_DIR=~/.local/state/linkedin-godmode/profiles
LINKEDIN_GODMODE_DEFAULT_PROVIDER=local
LINKEDIN_GODMODE_HEADLESS=false
LINKEDIN_GODMODE_READ_ONLY=false
LINKEDIN_GODMODE_HOST_ALLOWLIST=www.linkedin.com,linkedin.com
LINKEDIN_GODMODE_TIMEOUT_MS=30000
LINKEDIN_GODMODE_MAX_OUTPUT_BYTES=1000000
LINKEDIN_GODMODE_MAX_RESPONSE_BYTES=1000000
